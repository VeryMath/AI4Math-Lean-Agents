# =============================================================================
# Mode A（默认）：Gemini + LiteLLM（WSL-only）
# LiteLLM 将别名 anthropic-claude 映射到 gemini/gemini-2.5-pro
# =============================================================================
GEMINI_API_KEY=your-gemini-api-key-here
# LiteLLM 进程使用上述 key；Numina 侧指向本地代理：
ANTHROPIC_BASE_URL=http://localhost:4000
ANTHROPIC_AUTH_TOKEN=sk-anything
ANTHROPIC_MODEL=anthropic-claude
# NO_PROXY=localhost,127.0.0.1

# =============================================================================
# Mode C（回退）：DeepSeek Anthropic 兼容直连
# 启用时：注释掉上方 Mode A 的 BASE_URL/MODEL，改用本块（勿与 localhost 混用）
# =============================================================================
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_API_KEY=${DEEPSEEK_API_KEY}
# ANTHROPIC_AUTH_TOKEN=${DEEPSEEK_API_KEY}
# ANTHROPIC_MODEL=deepseek-v4-flash

# =============================================================================
# Agent / Bank（Phase 2；密钥仍只放环境变量，勿写入仓库）
# =============================================================================
# MAX_MODEL_TIER=3
# 类别门控见 docs/MODEL_ROUTING.md；Success/Error 默认 pending_review
# 升 tier：Mode A 只用 LiteLLM 已注册别名；需要更强且无别名时切 Mode C（deepseek-v4-pro）

# 禁止：
# - 模型名含 [1m] 等脏字符
# - ANTHROPIC_BASE_URL=http://localhost:4000 且 ANTHROPIC_MODEL=deepseek*
